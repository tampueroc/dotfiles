theme = TokyoNight
background = #0E1419

shell-integration = none
shell-integration-features = ssh-terminfo,ssh-env
macos-option-as-alt = false
macos-titlebar-style = tabs

working-directory = home
window-inherit-working-directory = false

font-feature = "-calt, -liga, -dlig"

cursor-style = block
mouse-hide-while-typing

window-new-tab-position = end

# Tmux-style prefix for Ghostty splits.
keybind = ctrl+a>shift+5=new_split:right
# keybind = ctrl+a>quote=new_split:down
# keybind = ctrl+a>h=goto_split:left
# keybind = ctrl+a>j=goto_split:down
# keybind = ctrl+a>k=goto_split:up
# keybind = ctrl+a>l=goto_split:right

keybind = super+shift+p=toggle_command_palette
