theme = tokyonight

# Split navigation with ctrl+a prefix
keybind = ctrl+a>left=goto_split:left
keybind = ctrl+a>right=goto_split:right
keybind = ctrl+a>up=goto_split:up
keybind = ctrl+a>down=goto_split:down

# Zoom current split
keybind = ctrl+a>z=toggle_split_zoom

# Create splits (tmux-style)
keybind = ctrl+a>shift+5=new_split:right
keybind = ctrl+a>shift+apostrophe=new_split:down

# Delete/close current split (tmux-style: prefix + x)
keybind = ctrl+a>x=close_surface
